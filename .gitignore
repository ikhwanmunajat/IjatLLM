# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
next-env.d.ts
/dist/
/.wrangler/
/.sites-runtime/
/outputs/
/work/

# BEGIN IJATLLM SECURITY FILTER

# Environment dan credential
.env
.env.*
!.env.example
!**/.env.example
**/secrets/
**/credentials/
**/*credential*.json
**/*service-account*.json
**/.cloudflared/
**/cert.pem
**/*.pem
**/*.key
**/*.pfx
**/*.jks
**/*.keystore

# Node.js
**/node_modules/
**/.next/
**/.nuxt/
**/.turbo/
**/.cache/
**/dist/
**/build/
**/coverage/

# Python
**/__pycache__/
**/*.py[cod]
**/.venv/
**/venv/
**/.pytest_cache/
**/.mypy_cache/

# Data runtime
/logs/
/tmp/
/temp/
/uploads/
/backups/
/storage/
*.log
*.pid
*.tmp
*.db
*.sqlite
*.sqlite3

# Data lokal Docker
/postgres-data/
/redis-data/
/grafana-data/
/prometheus-data/
/minio-data/
/docker-data/
/volumes/

# Arsip dan cadangan
*.zip
*.rar
*.7z
*.tar
*.tar.gz
*.bak
*.backup

# Sistem dan editor
Thumbs.db
desktop.ini
.DS_Store
.vscode/
