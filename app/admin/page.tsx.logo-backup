"use client";
import { useState } from "react";

const users=[["Ijat Anggara","ijat@example.com","Developer","Rp284.750","Active"],["Dina Nuraini","dina@example.com","Developer","Rp129.400","Active"],["Raka Aditya","raka@example.com","Enterprise","Rp2.450.000","Active"],["Sinta Maharani","sinta@example.com","Pay As You Go","Rp0","Suspended"],["Bima Prasetyo","bima@example.com","Developer","Rp84.210","Active"]];
export default function AdminPage(){const[section,setSection]=useState("Overview");const sections=["Overview","Users","Organizations","Workspaces","API Keys","Providers","Models","Pricing","Usage","Spend Logs","Wallets","Payments","Reconciliation","Refunds","Promotions","Announcements","Support Tickets","System Status","Audit Logs","Settings"];return <main className="admin-shell"><aside><a className="brand light-brand" href="/"><span className="brand-mark"><i/><i/><i/></span><span>Ijat<span>LLM</span></span></a><span className="admin-label">ADMIN PORTAL</span><nav>{sections.map((x,i)=><button className={section===x?"active":""} onClick={()=>setSection(x)} key={x}><i>{["⌂","♙","◇","WS","⌁","◈","M","Rp","▥","≡","◉","↔","◎","↩","%","i","?","●","☷","⚙"][i]}</i>{x}{x==="Reconciliation"&&<b>3</b>}</button>)}</nav><div className="admin-user"><span>IA</span><div><b>Ijat Anggara</b><small>SUPER_ADMIN</small></div><i>⋮</i></div></aside><section><header><div><small>Admin /</small><b>{section}</b></div><label>⌕<input placeholder="Cari apa saja..."/></label><button>♢<i/></button><span>IA</span></header><div className="admin-page"><div className="page-title"><div><span>OPERATIONS CONSOLE</span><h1>{section}</h1><p>Pantau operasional, margin, risiko, dan kesehatan platform secara real-time.</p></div><div className="title-actions"><button className="action">⇩ Export</button><button className="action primary-action">＋ Tambah baru</button></div></div>{section==="Overview"?<AdminOverview/>:<AdminTable section={section}/>}</div></section></main>}
function AdminOverview(){return <><div className="admin-kpis">{[["Total revenue","Rp248,4 jt","↑ 18,2%"],["Provider cost","Rp172,1 jt","↑ 14,8%"],["Gross margin","30,7%","↑ 2,4%"],["Total users","4.842","↑ 284"],["API requests","28,4 jt","↑ 21,5%"],["Error rate","0,18%","↓ 0,04%"]].map((r,i)=><article key={r[0]}><span>{r[0]}<i>{["Rp","$","%","♙","⌁","!"][i]}</i></span><b>{r[1]}</b><small className={i===1||i===4?"neutral":"good"}>{r[2]} bulan ini</small></article>)}</div><div className="dashboard-grid admin-grid"><article className="panel usage-chart"><Panel title="Revenue & provider cost"/><div className="admin-chart"><div className="chart-legend"><span><i/>Revenue</span><span><i/>Provider cost</span></div>{[42,55,48,68,62,78,72,88,82,94,91,100].map((h,i)=><div key={i}><i style={{height:`${h}%`}}/><em style={{height:`${h*.68}%`}}/></div>)}</div></article><article className="panel provider-health"><Panel title="Provider health"/>{[["OpenAI","99,98%","384 ms"],["Anthropic","99,72%","714 ms"],["Google Gemini","99,96%","412 ms"],["DeepSeek","99,91%","452 ms"],["Mistral","99,88%","491 ms"]].map((r,i)=><div key={r[0]}><span><i className={i===1?"warn":""}/><b>{r[0]}<small>{r[2]}</small></b></span><strong>{r[1]}</strong></div>)}</article></div><div className="dashboard-grid admin-grid"><article className="panel data-panel"><Panel title="User terbaru"/><AdminTable section="Users" compact/></article><article className="panel admin-alerts"><Panel title="Perlu perhatian"/><div><i>!</i><span><b>3 reconciliation gagal</b><small>Usage belum terdebit perlu ditinjau</small></span><button>Periksa →</button></div><div><i className="warn">!</i><span><b>Anthropic degraded</b><small>P95 latency mencapai 1,8 detik</small></span><button>Detail →</button></div><div><i>Rp</i><span><b>12 wallet saldo rendah</b><small>Notifikasi otomatis sudah dikirim</small></span><button>Lihat →</button></div></article></div></>}
function Panel({title}:{title:string}){return <header className="panel-head"><div><h3>{title}</h3><p>Hari ini · WIB</p></div><button>•••</button></header>}
function AdminTable({section,compact}:{section:string;compact?:boolean}){return <article className={compact?"":"panel data-panel"}><div className="table-toolbar"><label>⌕ <input placeholder={`Cari ${section.toLowerCase()}...`}/></label><select><option>Semua status</option><option>Active</option><option>Suspended</option></select></div><div className="data-table admin-users"><div className="row head"><span>USER</span><span>PLAN</span><span>SALDO</span><span>REQUEST</span><span>STATUS</span><span/></div>{users.slice(0,compact?4:5).map((r,i)=><div className="row" key={r[1]}><span><i className="avatar small-avatar">{r[0].split(" ").map(x=>x[0]).join("")}</i><b>{r[0]}<small>{r[1]}</small></b></span><span>{r[2]}</span><b>{r[3]}</b><span>{(12-i*2)+",4K"}</span><span className={r[4]==="Active"?"pill success":"pill fail"}>{r[4]}</span><button>•••</button></div>)}</div></article>}
